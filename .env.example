# Required. Use the staging project (gvents-staging) locally and in Vercel Preview.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Public base URL, used for share links and ticket emails.
# Production: https://gventz.com. Staging branch: https://staging.gventz.com. Other previews: leave unset (each uses its own URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp fallback on the ticket page: G-ventZ's business number with country code, digits only
# (for example 2348012345678). Public, so NEXT_PUBLIC_ is fine. Empty = the section is hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional "Happening elsewhere" sources on /discover. Leave empty to skip a source.
TICKETMASTER_API_KEY=
PREDICTHQ_API_KEY=
# Comma-separated public .ics URLs
ICAL_FEED_URLS=

# Ticket emails (Resend). Without RESEND_API_KEY, registrations still work but no email is sent.
# Until your domain is verified in Resend, leave TICKET_EMAIL_FROM empty: the test sender
# only delivers to the email address that owns the Resend account.
RESEND_API_KEY=
TICKET_EMAIL_FROM=

# Venue search on the event form (Google Places API (New)). Server-only: never add NEXT_PUBLIC_.
# Without it, the venue field is a plain text box and everything else still works.
GOOGLE_MAPS_API_KEY=

# Server only. Lets the ticket page re-send a guest's ticket and keeps the delivery log.
# Found in Supabase → Project Settings → API ("service_role"). Never add NEXT_PUBLIC_ to it.
# Without it, the "Email my ticket" section stays hidden.
SUPABASE_SERVICE_ROLE_KEY=
