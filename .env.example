# Required. Use the staging project (gvents-staging) locally and in Vercel Preview.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Bot protection on sign-in (FR-1.7): the Cloudflare Turnstile site key. Set it in Vercel when
# Turnstile is switched on in Supabase Auth (its secret key goes in Supabase, not here). Leave empty locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Set to 1 to show the "we're updating" page on every route (go-live cut-over). Server-only.
MAINTENANCE_MODE=
# At least 16 characters; staff set it as a `gventz_bypass` cookie to use the site during maintenance.
MAINTENANCE_BYPASS=

# Venue map on event pages (optional): a browser key restricted to the Maps Embed API and this
# site's domains. Without it the page uses Google's plain map embed.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Public base URL, used for share links. Production: https://g-vents.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# gventz-api (the NestJS backend). Server-only: never add NEXT_PUBLIC_.
# Venue search, emails and storage keys live on the API, not here.
API_URL=http://localhost:4000   # run the API locally with PORT=4000
# Same value as BFF_SHARED_SECRET on the API (gventz-api/scripts/generate-secrets.sh). Required in production.
BFF_SHARED_SECRET=
# Page refreshes from the API (/api/revalidate): same value as REVALIDATE_SECRET on the API, >= 32 characters.
REVALIDATE_SECRET=
