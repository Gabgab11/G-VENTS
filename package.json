{
  "name": "gvents-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && node scripts/logical-css.mjs --check && node scripts/check-design-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db",
    "db:types": "supabase gen types typescript --linked --schema public > src/lib/supabase/database.types.ts",
    "db:types:local": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "api:types": "openapi-typescript ${API_OPENAPI_URL:-../gventz-api/openapi.json} -o src/lib/api/schema.d.ts",
    "api:types:pinned": "bash .github/scripts/fetch-api-contract.sh \"$(tr -d '[:space:]' < api-contract.ref)\" .api-contract.json && API_OPENAPI_URL=.api-contract.json npm run -s api:types",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --env staging",
    "i18n:sync": "node scripts/i18n-sync.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "jsqr": "1.4.0",
    "lucide-react": "1.68.0",
    "next": "15.5.28",
    "next-intl": "4.14.9",
    "openapi-fetch": "0.17.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@opennextjs/cloudflare": "1.20.15",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "fast-check": "4.10.2",
    "openapi-typescript": "7.13.0",
    "typescript": "^5",
    "vitest": "^3",
    "wrangler": "4.156.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.29"
    },
    "use-intl": "4.14.9",
    "icu-minify": "4.14.9",
    "intl-messageformat": "12.1.4",
    "@formatjs/icu-messageformat-parser": "3.5.22"
  }
}
